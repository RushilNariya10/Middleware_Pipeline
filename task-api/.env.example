MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/task-manager-db?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=your-secure-jwt-secret
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Practical 10 (lab experiments only)
NOTIFICATION_DELAY_MS=0
# NOTIFY_MODE=inline
# SIMULATE_HANDLER_ERROR=true

# Practical 13 - AI (backend only, never commit real keys)
AI_PROVIDER=openai
OPENAI_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
AI_TIMEOUT_MS=8000
